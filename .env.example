# Database (SQLite local — keep for now)
DATABASE_URL="file:./dev.db"

# NextAuth — generate a long random secret for anything beyond local demo
AUTH_SECRET="generate-a-long-random-secret"
AUTH_URL="http://localhost:3000"

NEXT_PUBLIC_APP_NAME="PTT Shop"

# payOS. Để trống thì cổng payOS tắt. Không ghi giá trị thật vào mã.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Mốc thời gian ISO. Chỉ đơn payOS/chuyển khoản tạo sau mốc này mới bị tự huỷ khi quá hạn.
# Để trống cho tới khi deploy, để không đụng đơn đang có.
PAYMENT_HOLD_ENFORCE_FROM=

# Hãng vận chuyển. Để trống thì không gọi API, dùng phí dự phòng và mã vận đơn nhập tay.
GHN_TOKEN=
GHN_SHOP_ID=
GHN_WEBHOOK_TOKEN=
# sandbox (mặc định) hoặc production. Chỉ đổi khi đã có tài khoản production.
GHN_ENV=sandbox
GHTK_TOKEN=

# Hoá đơn điện tử. Để trống thì không gọi Viettel hay MISA.
EINVOICE_VIETTEL_USERNAME=
EINVOICE_VIETTEL_PASSWORD=
EINVOICE_VIETTEL_SUPPLIER_TAX_CODE=
EINVOICE_MISA_APP_ID=
EINVOICE_MISA_TAX_CODE=
EINVOICE_MISA_TOKEN=

# CRM rs.pttads.vn. Để trống thì không gọi mạng. Chưa có tài liệu API chính thức.
CRM_RS_BASE_URL=
CRM_RS_API_KEY=

# Email thông báo. Để trống thì không gửi SMTP/Resend thật.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
RESEND_API_KEY=

# Optional SMTP (Phase 8). When unset, emails are logged to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PTT Shop <noreply@pttshop.vn>"

# Local seed and scripts/rotate-admin only. Never commit real values.
# Seed refuses to run when NODE_ENV=production.
# rotate-admin additionally requires 12+ characters with upper, lower, and a digit.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Playwright / local tests. Do not reuse a production password.
E2E_ADMIN_EMAIL=""
E2E_ADMIN_PASSWORD=""
E2E_CUSTOMER_EMAIL=""
E2E_CUSTOMER_PASSWORD=""
