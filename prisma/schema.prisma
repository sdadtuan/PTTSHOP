generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  password      String?
  image         String?
  phone         String?
  role          Role           @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  cart          Cart?
  wishlist      WishlistItem[]
  reviews       Review[]
  addresses     Address[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  line1     String
  ward      String?
  district  String?
  city      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
}

model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  image       String?
  products    ProductCollection[]
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime            @default(now())
}

model Product {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  description  String?
  material     String?
  fit          String?
  thickness    String?
  stretch      Boolean             @default(false)
  origin       String?             @default("Việt Nam")
  gender       Gender              @default(UNISEX)
  categoryId   String?
  category     Category?           @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  variants     ProductVariant[]
  collections  ProductCollection[]
  reviews      Review[]
  isFeatured   Boolean             @default(false)
  isNew        Boolean             @default(false)
  isBestSeller Boolean             @default(false)
  rating       Float               @default(0)
  reviewCount  Int                 @default(0)
  /// PDP "Chi tiết" bullets (JSON string[]). Null = generated from fit.
  detailBulletsJson    String?
  /// PDP "Chất liệu" bullets (JSON string[]). Null = generated from material.
  materialBulletsJson  String?
  /// PDP size chart {columns, rows, note}. Null = built-in chart.
  sizeChartJson        String?
  /// PDP shipping bullets for this product only. Null = site default.
  shippingOverrideJson String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  color     String?
  /// "image" | "video" — additive; existing rows default to image
  type      String  @default("image")
  posterUrl String?
  /// Ẩn khỏi trang khách (giữ dữ liệu, không xóa) — additive
  isHidden  Boolean @default(false)
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// Homepage hero banners — additive table only (no wipe).
model HeroBanner {
  id          String   @id @default(cuid())
  imageUrl    String
  title       String?
  subtitle    String?
  ctaLabel    String?
  ctaHref     String?
  /// CSS object-position / focal, e.g. "50% 20%"
  focalPoint  String   @default("50% 20%")
  gridCols    Int      @default(2)
  gridRows    Int      @default(3)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductVariant {
  id            String         @id @default(cuid())
  sku           String         @unique
  color         String
  colorHex      String?
  size          String
  price         Int
  compareAt     Int?
  stock         Int            @default(0)
  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)

  @@unique([cartId, variantId])
}

model WishlistItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, variantId])
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  status          OrderStatus    @default(PENDING)
  paymentMethod   PaymentMethod  @default(COD)
  paymentStatus   PaymentStatus  @default(UNPAID)
  paymentProvider String?
  paymentRef      String?
  customerName    String
  customerPhone   String
  customerEmail   String?
  address         String
  note            String?
  couponCode      String?
  subtotal        Int
  shippingFee     Int            @default(0)
  discount        Int            @default(0)
  total           Int
  items           OrderItem[]
  reviews         Review[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating    Int
  comment   String?
  /// When false, hidden from storefront but kept in admin.
  isPublished Boolean @default(true)
  /// Admin-entered review (no purchase); shown with displayName.
  isAdminCreated Boolean @default(false)
  displayName String?
  avatarUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  name      String
  color     String
  size      String
  price     Int
  quantity  Int
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  discountType  String
  discountValue Int
  minOrder      Int       @default(0)
  maxUses       Int?
  usedCount     Int       @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean   @default(true)
}

model FlashSale {
  id        String   @id @default(cuid())
  title     String
  endsAt    DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Global brand / footer settings — published fields are live; draftJson is WIP.
model SiteSettings {
  id              String    @id @default("default")
  brandName       String    @default("VIZFAS")
  brandColor      String    @default("#f97316")
  logoUrl         String?
  footerTagline   String?
  contactAddress  String?
  contactEmail    String?
  contactPhone    String?
  contactHours    String?
  socialInstagram String?
  socialFacebook  String?
  socialTiktok    String?
  socialYoutube   String?
  seoTitle        String?
  seoDescription  String?
  /// PDP "Vận chuyển & Đổi trả" bullets (JSON string[]). Null = built-in copy.
  shippingPolicyJson String?
  /// Draft override blob (JSON). When set, admin edits draft; publish copies into columns.
  draftJson       String?
  publishedAt     DateTime?
  updatedAt       DateTime  @updatedAt
}

/// Homepage section CMS — draft* for WIP, contentJson/isEnabled for published.
model HomepageSection {
  id               String   @id @default(cuid())
  key              String   @unique
  label            String
  sortOrder        Int      @default(0)
  draftSortOrder   Int      @default(0)
  isEnabled        Boolean  @default(true)
  draftEnabled     Boolean  @default(true)
  contentJson      String   @default("{}")
  draftContentJson String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Customer-facing UI strings (cart, checkout, auth, …) — draft/publish.
model StorefrontUiCopy {
  id               String    @id @default("default")
  contentJson      String    @default("{}")
  draftContentJson String    @default("{}")
  publishedAt      DateTime?
  updatedAt        DateTime  @updatedAt
}

/// Records one-time CMS/data patches (e.g. nav link migrations); prevents re-applying after admin edits.
model CmsPatch {
  id        String   @id
  appliedAt DateTime @default(now())
}

/// Editable static storefront pages (vé chúng tôi, hỗ trợ, chính sách, …).
model StorefrontPage {
  id              String   @id @default(cuid())
  /// Route slug without leading slash, e.g. `ve-chung-toi` or `ho-tro/van-chuyen`
  slug            String   @unique
  title           String
  description     String?
  /// JSON string[] paragraphs / bullet lines (published).
  bodyJson        String   @default("[]")
  draftTitle      String?
  draftDescription String?
  draftBodyJson   String   @default("[]")
  isPublished     Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Version history snapshots of published homepage + site settings.
model HomepageVersion {
  id           String   @id @default(cuid())
  version      Int
  label        String?
  snapshotJson String
  createdAt    DateTime @default(now())
  createdById  String?
}
