generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  PAYOS
  VIETQR
  MOMO
  ZALOPAY
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  password      String?
  image         String?
  phone         String?
  role          Role           @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  cart          Cart?
  wishlist      WishlistItem[]
  reviews       Review[]
  addresses     Address[]
  roleAssignments UserRoleAssignment[]
  twoFactor     AdminTwoFactor?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  line1     String
  ward      String?
  district  String?
  city      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
}

model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  image       String?
  products    ProductCollection[]
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime            @default(now())
}

model Product {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  description  String?
  material     String?
  fit          String?
  thickness    String?
  stretch      Boolean             @default(false)
  origin       String?             @default("Việt Nam")
  gender       Gender              @default(UNISEX)
  categoryId   String?
  category     Category?           @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  variants     ProductVariant[]
  collections  ProductCollection[]
  reviews      Review[]
  isFeatured   Boolean             @default(false)
  isNew        Boolean             @default(false)
  isBestSeller Boolean             @default(false)
  rating       Float               @default(0)
  reviewCount  Int                 @default(0)
  /// PDP "Chi tiết" bullets (JSON string[]). Null = generated from fit.
  detailBulletsJson    String?
  /// PDP "Chất liệu" bullets (JSON string[]). Null = generated from material.
  materialBulletsJson  String?
  /// PDP size chart {columns, rows, note}. Null = built-in chart.
  sizeChartJson        String?
  /// PDP shipping bullets for this product only. Null = site default.
  shippingOverrideJson String?
  /// DRAFT | SELLING | HIDDEN | DISCONTINUED. Mặc định SELLING để bản ghi cũ vẫn hiện.
  saleStatus   String              @default("SELLING")
  /// Hàng demo. Storefront ẩn; admin vẫn xem. Không xóa cứng.
  isDemo       Boolean             @default(false)
  /// Chữ thường, không dấu, gồm tên, danh mục, màu và size. Null = chưa điền.
  searchText   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_searchText_trgm")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  color     String?
  /// "image" | "video" — additive; existing rows default to image
  type      String  @default("image")
  posterUrl String?
  /// Ẩn khỏi trang khách (giữ dữ liệu, không xóa) — additive
  isHidden  Boolean @default(false)
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// Homepage hero banners — additive table only (no wipe).
model HeroBanner {
  id          String   @id @default(cuid())
  imageUrl    String
  title       String?
  subtitle    String?
  ctaLabel    String?
  ctaHref     String?
  /// CSS object-position / focal, e.g. "50% 20%"
  focalPoint  String   @default("50% 20%")
  gridCols    Int      @default(2)
  gridRows    Int      @default(3)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductVariant {
  id            String         @id @default(cuid())
  sku           String         @unique
  color         String
  colorHex      String?
  size          String
  price         Int
  compareAt     Int?
  /// Giá vốn, chỉ trang quản trị. Null = chưa chốt.
  costPrice     Int?
  stock         Int            @default(0)
  /// Tồn an toàn kho riêng. Mặc định 0 để giữ cách bán hiện tại. Admin sửa từng biến thể.
  safetyStock   Int            @default(0)
  /// false = ẩn SKU khỏi giỏ. Không tự bật lại khi giá vốn giảm.
  isPurchasable Boolean        @default(true)
  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  supplierSkus  SupplierSku[]
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)

  @@unique([cartId, variantId])
}

model WishlistItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, variantId])
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  status          OrderStatus    @default(PENDING)
  paymentMethod   PaymentMethod  @default(COD)
  paymentStatus   PaymentStatus  @default(UNPAID)
  paymentProvider String?
  paymentRef      String?
  customerName    String
  customerPhone   String
  customerEmail   String?
  address         String
  note            String?
  couponCode      String?
  subtotal        Int
  /// Null = phí chưa báo, không phải 0đ. Đơn cũ giữ số đã lưu.
  shippingFee     Int?
  discount        Int            @default(0)
  total           Int
  receiptTokenHash String?
  paymentConfirmedAt DateTime?
  paymentConfirmedById String?
  paymentDueAt    DateTime?
  provinceCode    String?
  provinceName    String?
  wardCode        String?
  wardName        String?
  invoiceCompanyName String?
  invoiceTaxCode  String?
  invoiceAddress  String?
  invoiceEmail    String?
  payosOrderCode  Int?           @unique
  payosQr         String?
  items           OrderItem[]
  reviews         Review[]
  paymentAudits   PaymentAuditLog[]
  paymentTransactions PaymentTransaction[]
  shipments       Shipment[]
  invoices        Invoice[]
  cancellation    OrderCancellation?
  returnRequests  ReturnRequest[]
  refundRequests  RefundRequest[]
  supplierOrders  SupplierOrder[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating    Int
  comment   String?
  /// When false, hidden from storefront but kept in admin.
  /// Customer reviews are created with false in application code. The column
  /// default stays true so existing rows are not rewritten.
  isPublished Boolean @default(true)
  /// Admin-entered review (no purchase); shown with displayName.
  isAdminCreated Boolean @default(false)
  displayName String?
  avatarUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  name      String
  color     String
  size      String
  price       Int
  quantity    Int
  /// Số lượng lấy từ NCC. Phần còn lại lấy từ kho riêng.
  supplierQty Int     @default(0)
  supplierId  String?
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  discountType  String
  discountValue Int
  minOrder      Int       @default(0)
  maxUses       Int?
  usedCount     Int       @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean   @default(true)
}

model FlashSale {
  id        String   @id @default(cuid())
  title     String
  endsAt    DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Global brand / footer settings — published fields are live; draftJson is WIP.
model SiteSettings {
  id              String    @id @default("default")
  brandName       String    @default("PTT Shop")
  /// Số hotline hiển thị. Null hoặc rỗng thì giao diện không render.
  hotline         String?
  /// Link Messenger. Null hoặc rỗng thì không render.
  messengerUrl    String?
  brandColor      String    @default("#f97316")
  logoUrl         String?
  /// JSON LogoLayoutSettings (header/footer sizes). Null = storefront defaults (32/40px header).
  logoLayoutJson  String?
  footerTagline   String?
  contactAddress  String?
  contactEmail    String?
  contactPhone    String?
  contactHours    String?
  /// Link Zalo. Null hoặc rỗng thì không hiện nút.
  zaloUrl         String?
  /// Hiện "Còn N" khi tồn bán được <= ngưỡng. Null = không hiện số.
  lowStockThreshold Int?
  /// ID đo lường. Null = không tải script.
  ga4MeasurementId  String?
  metaPixelId       String?
  tiktokPixelId     String?
  clarityProjectId  String?
  socialInstagram String?
  socialFacebook  String?
  socialTiktok    String?
  socialYoutube   String?
  seoTitle        String?
  seoDescription  String?
  /// PDP "Vận chuyển & Đổi trả" bullets (JSON string[]). Null = built-in copy.
  shippingPolicyJson String?
  /// Draft override blob (JSON). When set, admin edits draft; publish copies into columns.
  draftJson       String?
  publishedAt     DateTime?
  updatedAt       DateTime  @updatedAt
}

/// Homepage section CMS — draft* for WIP, contentJson/isEnabled for published.
model HomepageSection {
  id               String   @id @default(cuid())
  key              String   @unique
  label            String
  sortOrder        Int      @default(0)
  draftSortOrder   Int      @default(0)
  isEnabled        Boolean  @default(true)
  draftEnabled     Boolean  @default(true)
  contentJson      String   @default("{}")
  draftContentJson String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Customer-facing UI strings (cart, checkout, auth, …) — draft/publish.
model StorefrontUiCopy {
  id               String    @id @default("default")
  contentJson      String    @default("{}")
  draftContentJson String    @default("{}")
  publishedAt      DateTime?
  updatedAt        DateTime  @updatedAt
}

/// Records one-time CMS/data patches (e.g. nav link migrations); prevents re-applying after admin edits.
model CmsPatch {
  id        String   @id
  appliedAt DateTime @default(now())
}

/// Editable static storefront pages (vé chúng tôi, hỗ trợ, chính sách, …).
model StorefrontPage {
  id              String   @id @default(cuid())
  /// Route slug without leading slash, e.g. `ve-chung-toi` or `ho-tro/van-chuyen`
  slug            String   @unique
  title           String
  description     String?
  /// JSON string[] paragraphs / bullet lines (published).
  bodyJson        String   @default("[]")
  draftTitle      String?
  draftDescription String?
  draftBodyJson   String   @default("[]")
  isPublished     Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Version history snapshots of published homepage + site settings.
model HomepageVersion {
  id           String   @id @default(cuid())
  version      Int
  label        String?
  snapshotJson String
  createdAt    DateTime @default(now())
  createdById  String?
}

model Consent {
  id            String    @id @default(cuid())
  subject       String
  userId        String?
  purpose       String
  policyVersion String
  granted       Boolean   @default(true)
  ip            String?
  kind          String    @default("grant")
  requestType   String?
  detail        String?
  status        String    @default("recorded")
  handledAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([subject])
  @@index([status])
}

/// Cài đặt COD, hạn giữ hàng và tài khoản nhận chuyển khoản. Null = mặc định trong code. Không có số tài khoản mẫu.
model PaymentSettings {
  id                  String  @id @default("default")
  codEnabled          Boolean?
  /// Null hoặc false = ẩn chuyển khoản. Chỉ hiện khi true và đủ tài khoản.
  bankTransferEnabled Boolean?
  codMaxAmount        Int?
  holdHours           Int?
  codConfirmHours     Int?
  bankBin             String?
  bankName            String?
  bankAccountNumber   String?
  bankAccountName     String?
  bankBranch          String?
  vietqrEnabled       Boolean @default(false)
  vietqrMerchantId    String?
  momoEnabled         Boolean @default(false)
  momoPartnerCode     String?
  zalopayEnabled      Boolean @default(false)
  zalopayAppId        String?
}

/// Thử nghiệm A/B. enabled=false thì mọi khách thấy control.
model Experiment {
  key            String  @id
  enabled        Boolean @default(false)
  variants       String
  trafficPercent Int     @default(50)
}

model PaymentTransaction {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String
  providerTxnId String
  amount        Int
  status        String
  createdAt     DateTime @default(now())

  @@unique([provider, providerTxnId])
  @@index([orderId])
}

model PaymentAuditLog {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action    String?
  actorId   String?
  amount    Int?
  createdAt DateTime @default(now())
}

model WebhookEvent {
  id        String   @id @default(cuid())
  eventId   String?  @unique
  orderNumber String?
  amount    Int?
  createdAt DateTime @default(now())
}

/// Một nguồn phí ship. Null = chưa cấu hình, không thay bằng số trong code. Kho để trống cho tới khi admin nhập.
model ShippingSettings {
  id                    String  @id @default("default")
  freeShipThreshold     Int?
  fallbackFee           Int?
  intraProvinceFee      Int?
  interProvinceFee      Int?
  parcelWeightGrams     Int?
  warehouseProvinceCode String?
  warehouseWardCode     String?
  warehouseAddress      String?
  senderName            String?
  senderPhone           String?
  defaultProvider       String?
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String?
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipmentNumber String?        @unique
  idempotencyKey String?        @unique
  provider       String?
  trackingCode   String?
  status             String?
  /// WAREHOUSE | SUPPLIER. Trống với vận đơn tạo trước dropship.
  fulfillmentSource  String?
  shippingFee        Int?
  codAmount          Int?
  items              ShipmentItem[]
  supplierOrder      SupplierOrder?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ShipmentItem {
  id          String    @id @default(cuid())
  shipmentId  String?
  shipment    Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId String?
  quantity    Int?
  createdAt   DateTime  @default(now())
}

model ShippingWebhookEvent {
  id         String   @id @default(cuid())
  eventId    String?  @unique
  provider   String?
  shipmentId String?
  createdAt  DateTime @default(now())
}

model CodReconcileSession {
  id        String             @id @default(cuid())
  provider  String?
  note      String?
  createdAt DateTime           @default(now())
  lines     CodReconcileLine[]
}

model CodReconcileLine {
  id             String               @id @default(cuid())
  sessionId      String?
  session        CodReconcileSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trackingCode   String?
  orderNumber    String?
  expectedAmount Int?
  actualAmount   Int?
  result         String?
  createdAt      DateTime             @default(now())
}

/// Cấu hình hoá đơn toàn site. Null = mặc định trong code. VAT để kế toán đối chiếu 0, 8 hoặc 10.
model InvoiceSettings {
  id               String   @id @default("default")
  provider         String?
  autoIssueEnabled Boolean?
  issueTrigger     String?
  templateCode     String?
  invoiceSeries    String?
  /// Thuế suất phần trăm trên giá đã gồm VAT. Kế toán đối chiếu chính sách hiện hành: 0, 8 hoặc 10.
  vatRate          Int?
  sellerName       String?
  sellerTaxCode    String?
  sellerAddress    String?
  maxRetries       Int?
  retryBaseMinutes Int?
}

model Invoice {
  id                       String            @id @default(cuid())
  orderId                  String
  order                    Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type                     String
  parentInvoiceId          String?
  parent                   Invoice?          @relation("InvoiceLink", fields: [parentInvoiceId], references: [id])
  children                 Invoice[]         @relation("InvoiceLink")
  /// Có giá trị khi đây là hoá đơn gốc chưa huỷ. Unique để không có hai gốc cùng đơn.
  originalOrderKey         String?           @unique
  idempotencyKey           String            @unique
  status                   String
  buyerKind                String
  buyerName                String
  buyerTaxCode             String?
  buyerAddress             String?
  buyerEmail               String?
  linesJson                String
  vatRate                  Int
  subtotalAmount           Int
  vatAmount                Int
  totalAmount              Int
  provider                 String?
  providerInvoiceId        String?
  invoiceNumber            String?
  templateCode             String?
  invoiceSeries            String?
  lookupCode               String?
  lookupUrl                String?
  issuedAt                 DateTime?
  adjustmentReason         String?
  retryCount               Int               @default(0)
  maxRetries               Int               @default(5)
  nextRetryAt              DateTime?
  lastError                String?
  needsAccountantAttention Boolean           @default(false)
  audits                   InvoiceAuditLog[]
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
}

model InvoiceAuditLog {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  action       String
  fromStatus   String?
  toStatus     String?
  actorId      String?
  metadataJson String?
  createdAt    DateTime @default(now())
}

/// Một dòng cho mỗi đơn đã huỷ. Unique để không hoàn tồn kho lần hai.
model OrderCancellation {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason    String
  actorId   String?
  createdAt DateTime @default(now())
}

model ReturnSettings {
  id                    String  @id @default("default")
  returnWindowDays      Int?
  excludedCategoryIds   String?
  dualApprovalThreshold Int?
}

model ReturnRequest {
  id               String       @id @default(cuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type             String
  reason           String
  note             String?
  status           String
  shippingFeePayer String
  exceptionReason  String?
  items            ReturnItem[]
  refunds          RefundRequest[]
  supplierDebits   SupplierDebit[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  quantity        Int
  restocked       Boolean       @default(false)
}

model RefundRequest {
  id                String               @id @default(cuid())
  orderId           String
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnRequestId   String?
  returnRequest     ReturnRequest?       @relation(fields: [returnRequestId], references: [id])
  idempotencyKey    String               @unique
  amount            Int
  refundMethod      String
  status            String
  bankAccountName   String?
  bankAccountNumber String?
  bankName          String?
  firstApproverId   String?
  secondApproverId  String?
  reference         String?
  approvals         RefundApprovalLog[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model RefundApprovalLog {
  id        String        @id @default(cuid())
  refundId  String
  refund    RefundRequest @relation(fields: [refundId], references: [id], onDelete: Cascade)
  actorId   String
  action    String
  note      String?
  createdAt DateTime      @default(now())
}

model CrmSettings {
  id               String  @id @default("default")
  provider         String?
  maxRetries       Int?
  retryBaseMinutes Int?
}

model CrmSyncJob {
  id           String    @id @default(cuid())
  dedupKey     String    @unique
  kind         String
  payloadJson  String
  status       String
  retryCount   Int       @default(0)
  maxRetries   Int       @default(5)
  nextRetryAt  DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model EmailSettings {
  id                  String  @id @default("default")
  provider            String?
  internalAlertEmails String?
  slaHours            Int?
  maxRetries          Int?
  retryBaseMinutes    Int?
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  body      String
  audience  String
  updatedAt DateTime @updatedAt
}

model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime @default(now())

  @@unique([userId, role])
}

model AdminTwoFactor {
  userId            String    @id
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted   String
  enabled           Boolean   @default(false)
  recoveryCodesHash String?
  enabledAt         DateTime?
  verifiedAt        DateTime?
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorEmail  String?
  actorRoles  String?
  action      String
  entityType  String
  entityId    String?
  beforeJson  String?
  afterJson   String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model PricingRule {
  id         String   @id @default(cuid())
  name       String
  floorPrice Int?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Một bộ tham số G cho cả site. Chưa có dòng thì code dùng mặc định.
model FloorSettings {
  id            String   @id @default("default")
  /// Giá sàn nhập tay, đồng. Trống = không có sàn tay.
  manualFloor   Int?
  /// m, r, a, f, VAT theo phần vạn. 1500 = 15%.
  marginBps     Int      @default(1500)
  returnBps     Int      @default(500)
  adsBps        Int      @default(0)
  feeBps        Int      @default(0)
  vatBps        Int      @default(0)
  /// S, chi phí kiện thêm, đồng/đơn vị.
  shippingCost  Int      @default(0)
  /// P
  paymentCost   Int      @default(0)
  /// F
  fixedCost     Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Supplier {
  id                     String         @id @default(cuid())
  code                   String         @unique
  name                   String
  taxCode                String?
  contactName            String?
  email                  String?
  phone                  String?
  address                String?
  /// FILE | GOOGLE_SHEET | MANUAL | API_STUB
  connectionType         String
  sheetUrl               String?
  slaHours               Int            @default(48)
  warnHours              Int            @default(24)
  syncEveryHours         Int            @default(24)
  lastSyncAt             DateTime?
  contractRef            String?
  contractExpiresAt      DateTime?
  /// NONE | WRITTEN | OWN_PHOTOS
  imageLicense           String         @default("NONE")
  imageLicenseNote       String?
  imageLicenseExpiresAt  DateTime?
  paysReturnFee          Boolean?
  isActive               Boolean        @default(true)
  skus                   SupplierSku[]
  syncRuns               SyncRun[]
  orders                 SupplierOrder[]
  debits                 SupplierDebit[]
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

model SupplierSku {
  id             String         @id @default(cuid())
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  supplierSku    String
  priority       Int
  costPrice      Int
  supplierStock  Int
  safetyStock    Int            @default(2)
  stockUpdatedAt DateTime?
  isActive       Boolean        @default(true)

  @@unique([supplierId, supplierSku])
  @@unique([supplierId, variantId])
}

model SyncRun {
  id           String    @id @default(cuid())
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// FILE | GOOGLE_SHEET | MANUAL | STUB
  source       String
  startedAt    DateTime
  finishedAt   DateTime?
  /// RUNNING | OK | PARTIAL | FAILED
  status       String
  rowsRead     Int       @default(0)
  rowsChanged  Int       @default(0)
  rowsErrored  Int       @default(0)
  errorDetail  String?
}

model SupplierOrder {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipmentId   String?         @unique
  shipment     Shipment?       @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  supplierId   String
  supplier     Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// DRAFT | READY | SENT | ACKNOWLEDGED | SHIPPED | CANCELLED | SLA_BREACH
  status       String
  poNumber     String          @unique
  trackingCode String?
  slaDueAt     DateTime?
  warnAt       DateTime?
  warnedAt     DateTime?
  sentAt       DateTime?
  fileName     String?
  emailSubject String?
  emailBody    String?
  debits       SupplierDebit[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model SupplierDebit {
  id               String         @id @default(cuid())
  supplierId       String
  supplier         Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierOrderId  String?
  supplierOrder    SupplierOrder? @relation(fields: [supplierOrderId], references: [id], onDelete: SetNull)
  returnRequestId  String?
  returnRequest    ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  amount           Int
  reason           String
  /// DRAFT | CONFIRMED | SETTLED
  status           String
  note             String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model EmailOutbox {
  id          String    @id @default(cuid())
  templateKey String
  toAddress   String
  subject     String
  body        String
  status      String
  retryCount  Int       @default(0)
  maxRetries  Int       @default(5)
  nextRetryAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Old product slug → current slug. Rows are inserted when a slug changes.
model SlugRedirect {
  id        String   @id @default(cuid())
  fromSlug  String   @unique
  toSlug    String
  productId String?
  createdAt DateTime @default(now())

  @@index([toSlug])
}

/// Sự kiện tìm kiếm. Không lưu IP, user agent hay thông tin cá nhân.
/// Dọn tay, giữ 90 ngày:
/// DELETE FROM "SearchEvent" WHERE "createdAt" < now() - interval '90 days';
model SearchEvent {
  id          String   @id @default(cuid())
  kind        String
  query       String
  normalized  String
  parsedJson  String?
  resultCount Int      @default(0)
  targetSlug  String?
  sessionKey  String?
  createdAt   DateTime @default(now())

  @@index([sessionKey, kind, createdAt])
  @@index([createdAt])
}

/// One purchase signal per order and channel. eventId is the order number.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  orderNumber String
  channel     String
  eventName   String
  eventId     String
  createdAt   DateTime @default(now())

  @@unique([orderNumber, channel, eventName])
  @@index([eventId])
}
